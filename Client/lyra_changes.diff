+void ULyraCharacterMovementComponent::ControlledCharacterMove(const FVector& InputVector, float DeltaSeconds)
+{
+	if (MOBPreMoveHook)
+	{
+		FVector Input = InputVector;
+		MOBPreMoveHook(this, Input, DeltaSeconds);
+		Super::ControlledCharacterMove(Input, DeltaSeconds);
+		if (MOBPostMoveHook)
+		{
+			MOBPostMoveHook(this, DeltaSeconds);
+		}
+		return;
+	}
+	Super::ControlledCharacterMove(InputVector, DeltaSeconds);
+}
+
+void ULyraCharacterMovementComponent::PhysWalking(float deltaTime, int32 Iterations)
+{
+	if (MOBMoveHook)
+	{
+		MOBMoveHook(this, deltaTime);
+		return;
+	}
+	Super::PhysWalking(deltaTime, Iterations);
+}
+
+void ULyraCharacterMovementComponent::PhysCustom(float deltaTime, int32 Iterations)
+{
+	if (MOBMoveHook)
+	{
+		MOBMoveHook(this, deltaTime);
+		return;
+	}
+	Super::PhysCustom(deltaTime, Iterations);
+}
+
+void ULyraCharacterMovementComponent::PhysFalling(float deltaTime, int32 Iterations)
+{
+	if (MOBMoveHook)
+	{
+		MOBMoveHook(this, deltaTime);
+		return;
+	}
+	Super::PhysFalling(deltaTime, Iterations);
+}
